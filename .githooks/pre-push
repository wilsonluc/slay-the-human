#!/bin/sh
# Block direct pushes to main. Changes reach main only through a squash-merged PR.
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: direct push to main is blocked. Push a branch and open a draft PR." >&2
    exit 1
  fi
done
exit 0
